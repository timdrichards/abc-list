# Copy to .env.local for local development. The deploy workflow reads the same three
# names from GitHub Actions secrets.
#
# Both values below come from your Supabase project. The quickest route is the
# "Connect" button at the top of the project dashboard, which shows the URL and the
# publishable key together. Settings > API Keys lists every key your project has.
#
# The publishable key is PUBLIC BY DESIGN. It identifies the project, it does not grant
# access. Access is decided by Supabase Auth plus the row level security policies in
# supabase/schema.sql, both enforced on Supabase's servers. Shipping it in the browser
# bundle is the intended use.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# The single shared account the whole family signs in as. Only the password is typed
# into the app; this address just identifies which account the password belongs to.
VITE_FAMILY_EMAIL=family@example.com
